{
	"name": "chnobli-svelte",
	"version": "0.1.4",
	"author": "Sören Meier <info@soerenmeier.ch>",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/chuchi-dev/chnobli.git"
	},
	"license": "MIT",
	"module": "dist/index.js",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"!dist/tests"
	],
	"scripts": {
		"lint": "eslint ./src",
		"test": "vitest run",
		"check-jsr": "jsr publish --dry-run",
		"build": "svelte-package -i ./src",
		"watch": "svelte-package -i ./src -w"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"chnobli": "^0.1.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.4.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"eslint": "^8.57.0",
		"jsdom": "^25.0.0",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.0.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"typescript-eslint": "^7.11.0",
		"vitest": "^1.1.3"
	}
}
